{
  "name": "saas-admin-panel",
  "version": "1.0.0",
  "description": "test project with micro saas admin panel",
  "homepage": "https://github.com/vasyl-chyypesh/saas-admin-panel#readme",
  "bugs": {
    "url": "https://github.com/vasyl-chyypesh/saas-admin-panel/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vasyl-chyypesh/saas-admin-panel.git"
  },
  "license": "ISC",
  "author": "Vasyl Chyypesh",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "npm run dev:api & npm run dev:ui",
    "dev:api": "node --env-file-if-exists=.env --watch src/api/server.ts",
    "dev:ui": "vite",
    "build": "npm run build:ui && npm run build:api",
    "build:ui": "vite build",
    "build:api": "tsc -p tsconfig.api.json",
    "start": "node --env-file-if-exists=.env dist/api/server.js",
    "typecheck": "tsc -p tsconfig.api.json --noEmit && tsc -p tsconfig.ui.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node --test --test-isolation=process \"test/**/*.test.ts\"",
    "test:coverage": "c8 npm test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "update:deps": "npx npm-check-updates"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.3.0",
    "c8": "12.0.0",
    "oxlint": "1.94.0",
    "prettier": "3.10.1",
    "supertest": "7.3.2",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}

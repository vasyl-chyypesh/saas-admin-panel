# Port Express listens on (also serves the built React bundle).
PORT=3000

# development | production
NODE_ENV=development

# Oncade integration. Optional: leave both blank to run without invoicing.
# If set, set both. The key must be a platform key (oncade_platform_test_... or
# oncade_platform_live_...); its prefix decides whether invoices are test or live.
ONCADE_API_KEY=
ONCADE_BUSINESS_ID=
# Optional. Defaults to https://www.oncade.gg
# ONCADE_API_URL=
